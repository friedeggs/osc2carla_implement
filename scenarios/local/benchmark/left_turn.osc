import "domain.osc"

# Unprotected left turn across oncoming traffic -- LOCAL SIMULATOR port of
# scenarios/benchmark/left_turn.osc.
#
#   python -m osc2carla scenarios/local/benchmark/left_turn.osc \
#       --backend pygame --town grid --junction-turn left --sim-duration 20
#
# Natural-language scenario, unchanged from the CARLA original:
#
#   The ego makes an unprotected left turn at an intersection with background
#   traffic in both directions.  A car ahead of it completes the same turn in a
#   gap.  The ego follows through on a gap that has already closed, and an
#   oncoming vehicle -- travelling the opposite direction of the ego's original
#   lane -- hits it while it is turning across.
#
# Stage geometry -- centre junction of the `grid` town, centre (80, 80), box
# x in [69, 91], y in [69, 91]:
#
#      ego, lead_turner        --->  y = 81.75 eastbound, lane -1
#      ==============================[ (80, 80) ]==============================
#      oncoming                     <---  y = 78.25 westbound, lane +1
#      oncoming_b                   <---  y = 74.75 westbound, lane +2
#                                     |
#                                     v  the ego's left-turn arc exits north
#                                        on x = 81.75, running -y
#
#   * conflict point = (79.80, 78.25): where the ego's turn arc crosses the
#     oncoming lane.  The classic unprotected-left conflict -- the ego has to
#     cross a lane it does not have priority on.
#
# Routing.  drive() follows next()[0], so which way a vehicle goes through a
# junction is a property of the lane it is on.  --junction-turn selects the
# map-wide preference and the town's lane-pairing rule supplies the per-actor
# difference: a left turn is connected only from the INNERMOST lane, exactly
# as on a real road.  That is what lets one scenario mix manoeuvres:
#
#   * ego, lead_turner            -> eastbound lane -1 (inner)  -> turn left
#   * oncoming                    -> westbound lane +1 (inner)  -> would turn,
#                                    but never reaches the box before the
#                                    conflict; it is timed to arrive as the
#                                    ego crosses its lane
#   * oncoming_b                  -> westbound lane +2 (outer)  -> no left
#                                    connector exists, so it goes straight
#
# How the failure to yield is expressed.  The CARLA original switched the
# oncoming vehicle to ram(target: ego) on @EGO_TURNING.  ram is not an
# OSC2Runner construct -- it appears nowhere in the paper -- so "holds its
# line" is now literal: it keeps driving its own lane at its own speed with
# keep_lane(), and drive() has no yielding term.  A vehicle that does not
# change what it is doing is a vehicle that does not give way, which is the
# entire content of an unprotected-left conflict.
#
# Differences from the CARLA original:
#   * v_oncoming is 28 kph rather than 19.  ram used to accelerate the
#     striking vehicle to ~50 kph regardless of its declared speed; without
#     it, the declared speed is the speed, and it has to be high enough to
#     reach the conflict point while the ego is still mid-arc.
#   * oncoming_b is placed absolutely on the outer lane rather than 12 m
#     behind oncoming, because its lane assignment is what keeps it going
#     straight through the junction (see Routing above).
#   * follow_gap is 20 m and v_follower 22 kph, up from 14 m and 26 kph. The
#     ego slows to v_turn for the corner and drive() has no car-following
#     model, so a closer or faster follower rear-ends the ego before the
#     oncoming vehicle arrives and takes the intended partner slot.
#
# Expected on the local backend: collision_occurred = true, first contact at
# t = 8.65 s, peak impulse ~5900, sole partner oncoming, striking an ego that
# is visibly mid-arc inside the junction. The conflict-point decal also
# registers static contacts as vehicles drive over it; those are reported
# separately and excluded from the collision verdict.

# No follower.  Both this file and its CARLA original used to place a Mercedes
# coupe behind the ego in the ego's own lane.  drive() has no car-following
# term, so it brakes for nothing and rear-ends any ego slower than the scripted
# one it was tuned against -- which experiment 001 measured happening in nine of
# twelve evaluable cells, ending episodes before the intended conflict was
# delivered.  Removed rather than re-tuned per policy: see the CARLA original
# for the full argument.

scenario left_turn:
    carla_map: map with:
        keep(it.map_file == "grid")

    env: environment

    # Declared first: lead_turner is placed topologically
    # relative to the ego.
    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    lead_turner: vehicle with:
        keep(it.name == "lead_turner")
        keep(it.model == "vehicle.audi.a2")
        keep(it.color == "20,20,20")

    # --- Oncoming carriageway ---
    oncoming: vehicle with:
        keep(it.name == "oncoming")
        keep(it.model == "vehicle.dodge.charger_2020")
        keep(it.color == "160,20,20")

    oncoming_b: vehicle with:
        keep(it.name == "oncoming_b")
        keep(it.model == "vehicle.seat.leon")
        keep(it.color == "0,90,160")

    # Where the ego's turn arc crosses the oncoming lane. A prop this flat is
    # a ground decal in the local simulator: it reports contact but never
    # deflects a car, so it can sit on a driving line. z cancels the
    # initializer's 0.5 m spawn lift.
    conflict_point: stationary_object with:
        keep(it.name == "conflict_point")
        keep(it.model == "static.prop.dirtdebris01")

    # --- Speeds ---
    var v_ego: speed = 30kph
    # Cornering speed: the controller has no lateral limit, so the turn
    # slow-down is commanded explicitly.
    var v_turn: speed = 18kph
    var v_lead: speed = 30kph
    # Tuned so oncoming is still short of the conflict point when the ego
    # commits, rather than already past it. Faster than this and it reaches
    # the crossing first, then homes BACK onto an ego that has not started
    # turning yet -- which lands as a head-on at the junction mouth instead of
    # a strike on a car mid-arc.
    var v_oncoming: speed = 28kph

    # --- Distances ---
    var lead_gap: length = 22m

    # The ego commits to the turn this far from the conflict point.
    var commit_radius: length = 14m

    do parallel:
        env.assign_celestial_position(azimuth: 0deg, elevation: 65deg)

        conflict_point.assign_position() with:
            position(x: 79.80, y: 78.25, z: -0.40, at: start)

        # ---- EGO: unprotected left across the oncoming carriageway ----
        serial:
            ego.assign_position() with:
                position(x: 32.00, y: 81.75, z: 0.00, h: 0.0rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                ego.drive() with:
                    speed(v_ego)
                wait @EGO_TURNING

            # Committed. drive() follows next()[0], which for this lane under
            # --junction-turn left is the left-turn connection onto the
            # northbound carriageway across the oncoming lanes.
            one_of:
                ego.drive() with:
                    speed(v_turn)
                wait elapsed(15s)

        # ---- LEAD_TURNER: same turn, taken while the gap is still open ----
        serial:
            lead_turner.assign_position() with:
                position(distance: lead_gap, ahead_of: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                lead_turner.drive() with:
                    speed(v_lead)
                wait elapsed(19s)

        # ---- ONCOMING: has priority, does not yield ----
        serial:
            oncoming.assign_position() with:
                position(x: 145.00, y: 78.25, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # Runs its own lane until the ego starts crossing it.
            one_of:
                oncoming.drive() with:
                    speed(v_oncoming)
                wait @EGO_TURNING

            # Holds its line into the turning ego rather than yielding.
            # Literally: it keeps driving its own lane at its own speed. This
            # baseline's drive() has no yielding or collision-avoidance term,
            # so a vehicle that does not change what it is doing is a vehicle
            # that does not give way -- which is the whole content of an
            # unprotected-left conflict.
            emit ONCOMING_HELD_LINE
            one_of:
                oncoming.drive() with:
                    speed(v_oncoming)
                    keep_lane()
                wait elapsed(13s)

        # ---- ONCOMING_B: outer lane, straight through ----
        serial:
            oncoming_b.assign_position() with:
                position(x: 137.00, y: 74.75, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                oncoming_b.drive() with:
                    speed(v_oncoming)
                wait elapsed(19s)

        # ---- Monitor: has the ego committed to crossing the oncoming lane? ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: conflict_point, direction: euclidean) < commit_radius)
            emit EGO_TURNING

        # ---- Termination guard ----
        wait elapsed(20s)
