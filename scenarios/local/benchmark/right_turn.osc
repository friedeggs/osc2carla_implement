import "domain.osc"

# Right turn out of a side road, rear-ended by traffic already on the lane the
# ego turns onto -- LOCAL SIMULATOR port of scenarios/benchmark/right_turn.osc.
#
#   python -m osc2carla scenarios/local/benchmark/right_turn.osc \
#       --backend pygame --town grid --junction-turn right --sim-duration 24
#
# Same natural-language scenario as the CARLA original:
#
#   The ego turns right out of the minor arm of an intersection onto a busier
#   road, against background traffic in both directions.  It is still slow from
#   the corner when it settles into its new lane.  A vehicle already travelling
#   on that lane arrives from behind and, instead of braking for the car that
#   has just pulled out in front of it, runs into the back of it.
#
# Stage geometry -- centre junction of the `grid` town, centre (80, 80), box
# x in [73, 87], y in [73, 87]:
#
#                                 |  x = 74.75 southbound (+y), lane -2
#                                 v  the ego comes down the north arm
#   merge_point (60, 74.75)  [ JUNCTION (80, 80) ]  <--- rear_ender, x = 148
#   =========================================================================
#   y = 74.75 westbound, lane +2   <--- destination lane
#   y = 78.25 westbound, lane +1   <--- adjacent_a, adjacent_b, straight
#   -------------------------------------------------------------------------
#   y = 81.75 eastbound, lane -1   ---> opposing
#
# Routing.  Under --junction-turn right the town's lane-pairing rule connects
# a right turn only from the OUTERMOST lane to the outermost lane, as on a
# real road, which is what lets this scenario mix manoeuvres:
#
#   * ego                  -> southbound lane -2 (outer) -> turns right
#   * adjacent_a/b         -> westbound lane +1 (inner)  -> no right connector
#                             exists from an inner lane, so they go straight
#   * opposing             -> eastbound lane -1 (inner)  -> straight
#   * rear_ender           -> westbound lane +2 (outer). It would turn right,
#                             but ram(target: ego) takes over once the ego is
#                             established in the lane ahead -- before it
#                             reaches the box -- exactly as in the original.
#
# Differences from the CARLA original:
#   * the merge point sits 13 m WEST of the junction exit, at (60, 74.75),
#     rather than at the exit itself.  This junction box is 14 m across, so a
#     marker at the exit is within merge_radius of the ego while it is still
#     on its approach down the north arm, and EGO_MERGED would fire before the
#     ego had turned at all.  Moving it down the destination lane makes the
#     condition mean what it says.
#   * corner_radius is 22 m rather than 18 m, following the merge point.
#   * v_turn is 12 kph rather than 16 kph, and v_rear 20 kph rather than 30.
#     Both follow from the corner, below.
#   * background traffic on the inner westbound lane starts 30 m closer, so it
#     has cleared the junction before the ego comes out of the corner rather
#     than being beside it at that moment.
#
# The corner, and what it costs.  Even with the junction's clear area (see
# GridTown.junction_margin) the right-turn connector is the tightest
# manoeuvre this town offers: ~9.6 m of arc against the bicycle model's
# ~4.5 m minimum turning radius.  The pure-pursuit controller tracks it, but
# comes out of it carrying ~2 m of lateral error, and its lookahead of 5 m
# closes that error more slowly than the 3.5 m lane spacing.  drive() calls
# get_waypoint() fresh every tick, so once the error exceeds half a lane the
# ego projects onto the INNER westbound lane and settles there instead of the
# outer one the connector fed it into.
#
# That is a controller artefact, not a scenario feature, and it is worth
# knowing when reading the run: the ego does turn right, is rear-ended in-lane
# from directly behind, and the metric is the intended one -- but it finishes
# one lane inboard of the connector's nominal exit.  rear_ender starts on the
# nominal exit lane and follows the ego across under ram(), so the impact
# geometry is unaffected.
#
# Expected on the local backend: collision_occurred = true, first contact at
# t = 13.8 s, peak impulse ~12400, sole partner rear_ender, in-lane from
# directly behind.
scenario right_turn:
    carla_map: map with:
        keep(it.map_file == "grid")

    env: environment

    # Declared first: adjacent_b is placed relative to adjacent_a, and keeping
    # the camera vehicle first matches the other benchmark scenarios.
    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    rear_ender: vehicle with:
        keep(it.name == "rear_ender")
        keep(it.model == "vehicle.nissan.patrol")
        keep(it.color == "80,80,80")

    # --- Background traffic ---
    adjacent_a: vehicle with:
        keep(it.name == "adjacent_a")
        keep(it.model == "vehicle.audi.a2")
        keep(it.color == "20,20,20")

    adjacent_b: vehicle with:
        keep(it.name == "adjacent_b")
        keep(it.model == "vehicle.mercedes.coupe")
        keep(it.color == "200,200,200")

    opposing: vehicle with:
        keep(it.name == "opposing")
        keep(it.model == "vehicle.citroen.c3")
        keep(it.color == "0,90,160")

    # Marks where the ego is established in the destination lane. A prop this
    # flat is a ground decal in the local simulator: it reports contact but
    # never deflects a car. z cancels the initializer's 0.5 m spawn lift.
    merge_point: stationary_object with:
        keep(it.name == "merge_point")
        keep(it.model == "static.prop.dirtdebris01")

    # --- Speeds ---
    var v_ego: speed = 22kph
    # Cornering speed. The controller has no lateral limit, so the slow-down
    # has to be commanded explicitly -- and it is what leaves the ego slow
    # enough for rear_ender to run into.
    var v_turn: speed = 12kph
    # A car that has just come round a corner is still slow.
    var v_exit: speed = 20kph
    var v_rear: speed = 20kph
    var v_adjacent: speed = 28kph
    var v_opposing: speed = 25kph

    # --- Distances ---
    var adjacent_gap: length = 20m
    # The ego commits to the corner this far from the merge point.
    var corner_radius: length = 22m
    # ...and counts as established in the destination lane inside this one.
    var merge_radius: length = 8m

    do parallel:
        env.assign_celestial_position(azimuth: 0deg, elevation: 65deg)

        merge_point.assign_position() with:
            position(x: 60.00, y: 74.75, z: -0.40, at: start)

        # ---- EGO: right turn out of the minor arm ----
        serial:
            ego.assign_position() with:
                position(x: 74.75, y: 45.00, z: 0.00, h: 1.5708rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                ego.drive() with:
                    speed(v_ego)
                wait rise(ego.object_distance(reference: merge_point, direction: euclidean) < corner_radius)

            emit EGO_AT_CORNER
            ego.set_lights(mode: brake)

            # Take the corner at v_turn. drive() follows next()[0], which for
            # this lane under --junction-turn right is the right-turn
            # connection onto the westbound outer lane.
            one_of:
                ego.drive() with:
                    speed(v_turn)
                wait @EGO_MERGED

            # Straighten up and pull away -- or would, if rear_ender were not
            # already closing on it.
            one_of:
                ego.drive() with:
                    speed(v_exit)
                wait elapsed(15s)

        # ---- REAR_ENDER: already on the destination lane, does not brake ----
        serial:
            rear_ender.assign_position() with:
                position(x: 148.00, y: 74.75, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                rear_ender.drive() with:
                    speed(v_rear)
                wait @EGO_MERGED

            # The ego is now in the lane ahead. No brake application.
            emit REAR_ENDER_COMMITTED
            one_of:
                rear_ender.ram(target: ego)
                wait elapsed(15s)

        # ---- Background: inner westbound lane, straight through ----
        serial:
            adjacent_a.assign_position() with:
                position(x: 100.00, y: 78.25, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                adjacent_a.drive() with:
                    speed(v_adjacent)
                wait elapsed(23s)

        serial:
            adjacent_b.assign_position() with:
                position(distance: adjacent_gap, behind: adjacent_a, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                adjacent_b.drive() with:
                    speed(v_adjacent)
                wait elapsed(23s)

        # ---- Background: opposing carriageway ----
        serial:
            opposing.assign_position() with:
                position(x: 20.00, y: 81.75, z: 0.00, h: 0.0rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                opposing.drive() with:
                    speed(v_opposing)
                wait elapsed(23s)

        # ---- Monitor: has the ego established itself in the new lane? ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: merge_point, direction: euclidean) < merge_radius)
            emit EGO_MERGED

        # ---- Termination guard ----
        wait elapsed(24s)
