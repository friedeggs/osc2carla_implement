import "domain.osc"

# Right turn out of a side road, rear-ended by a vehicle that does not slow
# for it -- LOCAL SIMULATOR port of scenarios/benchmark/right_turn.osc.
#
#   python -m osc2carla scenarios/local/benchmark/right_turn.osc \
#       --backend pygame --town grid --junction-turn right --sim-duration 24
#
# Natural-language scenario:
#
#   The ego turns right out of the minor arm of an intersection onto a busier
#   road, against background traffic in both directions.  It is still slow
#   from the corner when it settles into its new lane.  The vehicle behind it
#   never slowed for the corner and, instead of braking for the car in front,
#   runs into the back of it.
#
# Stage geometry -- centre junction of the `grid` town, centre (80, 80), box
# x in [69, 91], y in [69, 91]:
#
#                   ego, then rear_ender 35 m back
#                            |  x = 74.75 southbound (+y), lane -2
#                            v
#   merge_point (60, 74.75)  [ JUNCTION (80, 80) ]
#   =========================================================================
#   y = 74.75 westbound, lane +2   <--- destination lane
#   y = 78.25 westbound, lane +1   <--- adjacent_a, adjacent_b, straight
#   -------------------------------------------------------------------------
#   y = 81.75 eastbound, lane -1   ---> opposing
#
# Difference from the CARLA original, and why.  In the original, rear_ender is
# already travelling on the destination lane and arrives from behind the
# merge.  That cannot be staged here.  --junction-turn is a whole-map
# preference, and the town connects a right turn only between OUTERMOST lanes,
# so the ego must be on the outer lane to turn at all -- while a vehicle
# approaching on the destination lane from the east would take the same right
# turn rather than continuing straight.  The original papered over this with
# ram(target: ego), which homes on the ego regardless of lane; ram is not an
# OSC2Runner construct (it appears nowhere in the paper), so it is gone.
#
# rear_ender therefore queues behind the ego on the same approach and takes
# the same right turn.  The conflict is unchanged in kind -- a vehicle that
# does not slow, running into the back of one that did, in-lane and from
# directly behind -- and it is now produced entirely by geometry and speed
# rather than by a homing controller.  It is also more robust: the striking
# vehicle is directly behind the ego on the same path, so there is no timing
# knife-edge.
#
# The corner.  The right-turn connector is the tightest manoeuvre this town
# offers.  The pure-pursuit controller comes out of it carrying ~2 m of
# lateral error, more than half a lane, and drive() re-projects onto the
# nearest lane every tick -- so without help the ego finishes one lane inboard
# of the connector's exit.  keep_lane() (Table 2, Spatial Modifiers) fixes
# this: the leaf latches the lane the connector fed it into and holds it.
# Both the ego and rear_ender use it, which is why they finish on y = 74.75.
#
# Expected on the local backend: collision_occurred = true, EGO_MERGED at
# t = 8.95 s, first contact at t = 9.35 s, peak impulse ~4300, sole partner
# rear_ender.  The impulse is far below the CARLA original's ~18600 because
# nothing here is at full throttle: it is a 26 kph vehicle running into a
# 14 kph one, which is what the declared speeds say should happen.

scenario right_turn:
    carla_map: map with:
        keep(it.map_file == "grid")

    env: environment

    # Declared first: adjacent_b is placed relative to adjacent_a, and keeping
    # the camera vehicle first matches the other benchmark scenarios.
    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    rear_ender: vehicle with:
        keep(it.name == "rear_ender")
        keep(it.model == "vehicle.nissan.patrol")
        keep(it.color == "80,80,80")

    # --- Background traffic ---
    adjacent_a: vehicle with:
        keep(it.name == "adjacent_a")
        keep(it.model == "vehicle.audi.a2")
        keep(it.color == "20,20,20")

    adjacent_b: vehicle with:
        keep(it.name == "adjacent_b")
        keep(it.model == "vehicle.mercedes.coupe")
        keep(it.color == "200,200,200")

    opposing: vehicle with:
        keep(it.name == "opposing")
        keep(it.model == "vehicle.citroen.c3")
        keep(it.color == "0,90,160")

    # Marks where the ego is established in the destination lane. A prop this
    # flat is a ground decal in the local simulator: it reports contact but
    # never deflects a car. z cancels the initializer's 0.5 m spawn lift.
    merge_point: stationary_object with:
        keep(it.name == "merge_point")
        keep(it.model == "static.prop.dirtdebris01")

    # --- Speeds ---
    var v_ego: speed = 22kph
    # Cornering speed. The controller has no lateral limit, so the slow-down
    # has to be commanded explicitly -- and it is what leaves the ego slow
    # enough for rear_ender to run into.
    var v_turn: speed = 12kph
    # A car that has just come round a corner is still slow.
    var v_exit: speed = 14kph
    var v_rear: speed = 26kph
    var v_adjacent: speed = 28kph
    var v_opposing: speed = 25kph

    # --- Distances ---
    var adjacent_gap: length = 12m
    # How far back rear_ender starts on the same approach.
    var rear_gap: length = 35m
    # The ego commits to the corner this far from the merge point.
    var corner_radius: length = 22m
    # ...and counts as established in the destination lane inside this one.
    var merge_radius: length = 8m

    do parallel:
        env.assign_celestial_position(azimuth: 0deg, elevation: 65deg)

        merge_point.assign_position() with:
            position(x: 60.00, y: 74.75, z: -0.40, at: start)

        # ---- EGO: right turn out of the minor arm ----
        serial:
            ego.assign_position() with:
                position(x: 74.75, y: 50.00, z: 0.00, h: 1.5708rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                ego.drive() with:
                    speed(v_ego)
                wait rise(ego.object_distance(reference: merge_point, direction: euclidean) < corner_radius)

            emit EGO_AT_CORNER
            ego.set_lights(mode: brake)

            # Take the corner at v_turn. drive() follows next()[0], which for
            # this lane under --junction-turn right is the right-turn
            # connection onto the westbound outer lane.
            one_of:
                ego.drive() with:
                    speed(v_turn)
                wait @EGO_MERGED

            # Straighten up and pull away -- or would, if rear_ender were not
            # already closing on it.  keep_lane() latches the lane the corner
            # fed it into and holds it, instead of letting the residual
            # lateral error from the arc hand the ego to the neighbouring
            # lane on the next get_waypoint() call.
            one_of:
                ego.drive() with:
                    speed(v_exit)
                    keep_lane()
                wait elapsed(15s)

        # ---- REAR_ENDER: queued behind the ego, does not brake ----
        serial:
            rear_ender.assign_position() with:
                position(distance: rear_gap, behind: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # One speed, one lane, the whole way: it never slows for the
            # corner and it never brakes for the car that pulls out in front
            # of it.  What makes this a rear-end is precisely what is ABSENT
            # -- no change_speed, no yielding term in drive() -- so the
            # vehicle carries on into the space the ego occupies.  A single
            # uninterrupted leaf also lets keep_lane() re-latch on the way
            # out of the junction and hold the ego's lane rather than
            # wandering into the neighbouring one.
            one_of:
                rear_ender.drive() with:
                    speed(v_rear)
                    keep_lane()
                wait elapsed(21s)

        # ---- Background: inner westbound lane, straight through ----
        serial:
            adjacent_a.assign_position() with:
                position(x: 100.00, y: 78.25, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                adjacent_a.drive() with:
                    speed(v_adjacent)
                wait elapsed(23s)

        serial:
            adjacent_b.assign_position() with:
                position(distance: adjacent_gap, behind: adjacent_a, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                adjacent_b.drive() with:
                    speed(v_adjacent)
                wait elapsed(23s)

        # ---- Background: opposing carriageway ----
        serial:
            opposing.assign_position() with:
                position(x: 20.00, y: 81.75, z: 0.00, h: 0.0rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                opposing.drive() with:
                    speed(v_opposing)
                wait elapsed(23s)

        # ---- Monitor: has the ego established itself in the new lane? ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: merge_point, direction: euclidean) < merge_radius)
            emit EGO_MERGED

        # ---- Monitor: the moment the rear-end becomes unavoidable ----
        serial:
            wait @EGO_MERGED
            emit REAR_ENDER_COMMITTED

        # ---- Termination guard ----
        wait elapsed(24s)
