import "domain.osc"

# Red-light violation at an intersection -- LOCAL SIMULATOR port of
# scenarios/benchmark/red_light.osc.
#
#   python -m osc2carla scenarios/local/benchmark/red_light.osc \
#       --backend pygame --town grid --junction-turn straight --sim-duration 18
#
# Same natural-language scenario as the CARLA original:
#
#   The ego vehicle is crossing an intersection.  There is surrounding traffic
#   on both the ego's road and the crossing road.  While the ego is inside the
#   intersection, one of the vehicles on the crossing road runs its red light
#   and rams the ego from the side.
#
# Stage geometry -- centre junction of the `grid` town, centre (80, 80), box
# x in [73, 87], y in [73, 87].  Run `python -m osc2carla.localsim.mapview`
# for the full reference sheet.
#
#                        violator, stopper
#                            |  x = 78.25 southbound (+y), from the north arm
#                            v
#   ego, lead, follower <--- [ JUNCTION (80, 80) ] <--- ego enters from x = 135
#   ==========================================================================
#                     y = 78.25 westbound (-x), h = 3.1416
#
#   * conflict point = (78.25, 78.25): where the ego's westbound lane and the
#     violator's southbound lane cross.
#   * the ego's right hand points -y (north), so the violator entering on +y
#     from the north arm strikes the ego's right flank, as in the original.
#   * every vehicle here goes straight, so --junction-turn straight routes all
#     of them correctly and no two actors need different manoeuvres.
#
# Actors, unchanged from the original (5 vehicles + 1 reference marker):
#   ego, lead, follower on the westbound carriageway; violator (CarlaCola is
#   not in the local blueprint table, so a european_hgv stands in for the
#   truck) and stopper on the crossing road.
#
# Differences from the CARLA original, all of them geometric:
#   * approach lengths are shorter.  A grid arm is 66 m between junction
#     boxes, against the 50 m and 42 m run-ups the CARLA file uses, so the
#     ego starts 52 m out and the violator 42 m out rather than being placed
#     against a much larger junction.
#   * junction_entry_radius is 14 m, not 20 m: this junction box is 22 m
#     across where Town10HD_Opt's junction 189 measures ~20 m centre to stop
#     line.  conflict_radius is unchanged -- it is a property of how long the
#     ego takes to clear the crossing lane, not of the junction's size.
#
# Expected on the local backend: collision_occurred = true, first contact
# around t = 8 s, the violator's side impact on the ego inside the box.
scenario red_light:
    carla_map: map with:
        keep(it.map_file == "grid")

    env: environment

    # --- Ego and its surrounding traffic (westbound, y = 78.25) ---
    # Declared first: lead and follower are placed relative to it.
    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    lead: vehicle with:
        keep(it.name == "lead")
        keep(it.model == "vehicle.audi.a2")
        keep(it.color == "20,20,20")

    follower: vehicle with:
        keep(it.name == "follower")
        keep(it.model == "vehicle.mercedes.coupe")
        keep(it.color == "200,200,200")

    # --- Crossing-road traffic (southbound, x = 78.25) ---
    violator: vehicle with:
        keep(it.name == "violator")
        keep(it.model == "vehicle.carlamotors.european_hgv")

    stopper: vehicle with:
        keep(it.name == "stopper")
        keep(it.model == "vehicle.nissan.micra")
        keep(it.color == "0,90,160")

    # Ground decal at the conflict point of the two lanes, the fixed reference
    # the junction-occupancy conditions are written against.  The local
    # simulator treats a prop this flat as a decal: driving over it raises a
    # collision event but does not move the car, which is what CARLA does and
    # what lets the marker sit on a driving line at all.  Metrics discount
    # non-vehicle contacts either way.  z cancels the initializer's 0.5 m lift.
    conflict_point: stationary_object with:
        keep(it.name == "conflict_point")
        keep(it.model == "static.prop.dirtdebris01")

    # --- Speeds ---
    var v_ego: speed = 30kph
    var v_lead: speed = v_ego + 4kph
    var v_follower: speed = v_ego - 2kph
    var v_violator: speed = 32kph
    var v_stopper: speed = 26kph

    # --- Distances ---
    var lead_gap: length = 22m
    var follow_gap: length = 16m
    var queue_gap: length = 20m

    # The ego has entered the junction box once it is inside this radius of
    # the conflict point; the box is 14 m across here.
    var junction_entry_radius: length = 14m
    # ...and it occupies the patch the violator's lane actually crosses inside
    # this one.  The violator commits on the inner event: at 30 kph the ego
    # clears the crossing lane in about 0.3 s, so a ram launched a second
    # early turns into a rear-end pursuit instead of a side impact.
    var conflict_radius: length = 6m
    # The stopper starts braking this far from the conflict point.
    var stop_line_gap: length = 24m

    do parallel:
        env.assign_celestial_position(azimuth: 0deg, elevation: 70deg)

        conflict_point.assign_position() with:
            position(x: 78.25, y: 78.25, z: -0.40, at: start)

        # ---- EGO: crossing the intersection westbound ----
        serial:
            ego.assign_position() with:
                position(x: 130.00, y: 78.25, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # The ego never reacts: it holds its crossing speed throughout, so
            # the collision is entirely the violator's doing.
            one_of:
                ego.drive() with:
                    speed(v_ego)
                wait elapsed(17s)

        # ---- LEAD: same lane, clears the junction ahead of the ego ----
        serial:
            lead.assign_position() with:
                position(distance: lead_gap, ahead_of: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                lead.drive() with:
                    speed(v_lead)
                wait elapsed(17s)

        # ---- FOLLOWER: same lane, trails the ego into the junction ----
        serial:
            follower.assign_position() with:
                position(distance: follow_gap, behind: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                follower.drive() with:
                    speed(v_follower)
                wait elapsed(17s)

        # ---- VIOLATOR: runs the red and rams the ego ----
        serial:
            violator.assign_position() with:
                position(x: 78.25, y: 36.00, z: 0.00, h: 1.5708rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # Phase 1: approach the signal without slowing, unlike the stopper
            # on the same approach.
            one_of:
                violator.drive() with:
                    speed(v_violator)
                wait @EGO_AT_CONFLICT_POINT

            # Phase 2: enter on the red and strike the ego's side.
            emit RED_LIGHT_RUN
            one_of:
                violator.ram(target: ego)
                wait elapsed(11s)

        # ---- STOPPER: same approach, obeys the red at the stop line ----
        serial:
            stopper.assign_position() with:
                position(distance: queue_gap, behind: violator, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                stopper.drive() with:
                    speed(v_stopper)
                wait rise(stopper.object_distance(reference: conflict_point, direction: euclidean) < stop_line_gap)

            stopper.set_lights(mode: brake)
            stopper.change_speed(target: 0kph, rate_profile: asap)
            wait stopper.speed < 0.3kph

            # Hold at standstill: an active 0-speed controller is required or
            # the last applied VehicleControl latches and the car creeps
            # forward (same note as closed_loop_demo.osc).
            one_of:
                stopper.drive() with:
                    speed(0kph)
                wait elapsed(11s)

        # ---- Conflict monitor: how far the ego has committed ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: conflict_point, direction: euclidean) < junction_entry_radius)
            emit EGO_IN_JUNCTION
            wait rise(ego.object_distance(reference: conflict_point, direction: euclidean) < conflict_radius)
            emit EGO_AT_CONFLICT_POINT

        # ---- Termination guard ----
        wait elapsed(18s)
