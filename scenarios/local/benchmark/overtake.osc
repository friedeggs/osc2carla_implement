import "domain.osc"

# Overtake into oncoming traffic -- LOCAL SIMULATOR port of
# scenarios/benchmark/overtake.osc.
#
#   python -m osc2carla scenarios/local/benchmark/overtake.osc \
#       --backend pygame --town two_lane --sim-duration 16
#
# Natural-language scenario, unchanged from the CARLA original:
#
#   The ego comes up behind a slow lorry on an undivided two-way road.  It
#   pulls out to pass, into the lane that carries traffic the other way.  A
#   car is already coming the other way in that lane.  It does not slow down
#   or move over, and it meets the ego head-on while the ego is alongside the
#   lorry.
#
# Stage geometry -- the y = 0 road of the `two_lane` town, x in [7.5, 392.5]:
#
#      lane +1  y = -1.75   <- oncoming            (the lane the ego takes)
#      ---------------------------------- centre line
#      lane -1  y =  1.75   ego ->  lorry ->       (the ego's own lane)
#
#   * The road matters as much as the actors.  A divided highway cannot stage
#     this at all -- the lane to the left of the innermost one is a median
#     shoulder there, and change_lane rejects it by type.  On an undivided
#     road the left neighbour *is* the oncoming lane, which is exactly the
#     risk being taken.
#
# Actors (3 vehicles):
#   ego       Tesla Model 3 (camera vehicle).
#   lorry     European HGV, lead_gap ahead of the ego in the same lane at
#             v_lorry.  It is the reason to overtake: slow, long, and opaque.
#   oncoming  Dodge Charger in lane +1 at v_oncoming, closing head-on.
#
# Timeline:
#   t = 0            all three spawn at rest, launch on @go_signal.
#   t ~ 0-4          the ego, much quicker than a 12 t lorry, eats the gap.
#   gap<commit_gap   monitor emits EGO_COMMITTED; the ego pulls out with
#                    change_lane(side: left) at v_pass and runs down the
#                    oncoming lane.
#   contact          the oncoming car holds its line -- it keeps driving its
#                    own lane at its own speed, and drive() has no yielding
#                    term -- so the two meet head-on with the ego still
#                    alongside the lorry.
#   (if it clears)   the ego would finish the pass with change_lane(side:
#                    right) back into its own lane.  That branch is what the
#                    file describes as the *intended* manoeuvre; the collision
#                    is what actually happens.
#   t = 16           termination guard.
#
# side: is the driver's side, not the lane's.  The return leg asks for
# side: right while the ego is running against lane +1, where the lane's own
# right-hand neighbour is nothing at all.  LaneChangeLite takes the sense of
# the request from the actor's heading, so "right" means the ego's right in
# both legs of the pass.
#
# Differences from the CARLA original: only the stage.  Every speed and every
# distance is the same number in both files.  The CARLA original runs on
# Town04's road 51, which is the longest undivided two-way road in that map
# and a continuous ~90 deg bend; this is 385 m of dead straight.  The oncoming
# car's start position differs for that reason alone -- it is the one number
# that has to be measured off the stage rather than carried over.
#
# What the stage does to the outcome: on CARLA the head-on lands while the ego
# is level with the lorry and shoves it into the lorry as well, so both are
# listed as partners there.  Here the ego is clear of it and `oncoming` is the
# sole partner.
#
# Expected on the local backend: collision_occurred = true, first contact at
# t = 5.65 s, peak impulse ~29600, sole partner oncoming, with the ego in
# lane +1 -- a head-on, not a sideswipe of the lorry.  Under --ego-policy idm:
# no collision -- IDM never pulls out, so it simply follows the lorry.

scenario overtake:
    carla_map: map with:
        keep(it.map_file == "two_lane")

    env: environment

    # Declared first: the lorry is placed topologically relative to the ego.
    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    lorry: vehicle with:
        keep(it.name == "lorry")
        keep(it.model == "vehicle.carlamotors.european_hgv")
        keep(it.color == "40,100,60")

    oncoming: vehicle with:
        keep(it.name == "oncoming")
        keep(it.model == "vehicle.dodge.charger_2020")
        keep(it.color == "160,20,20")

    # --- Speeds ---
    var v_ego: speed = 48kph
    # Passing speed: the whole point of pulling out is to go faster than the
    # thing being passed.
    var v_pass: speed = 58kph
    var v_lorry: speed = 25kph
    var v_oncoming: speed = 45kph

    # --- Distances ---
    var lead_gap: length = 26m
    # Centre-to-centre. The lorry is 11.3 m long, so this is ~6 m of clear
    # road in front of the ego when it decides to pull out.
    var commit_gap: length = 13m

    do parallel:
        env.assign_celestial_position(azimuth: 0deg, elevation: 65deg)

        # ---- EGO: pull out, pass, pull back in ----
        serial:
            ego.assign_position() with:
                position(x: 40.00, y: 1.75, z: 0.00, h: 0.0rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                ego.drive() with:
                    speed(v_ego)
                    keep_lane()
                wait @EGO_COMMITTED

            # Into the oncoming lane. Nothing in the manoeuvre asks what is
            # already in it.
            ego.change_lane(num_of_lanes: 1, side: left) with:
                speed(v_pass)
            emit EGO_IN_ONCOMING_LANE

            # The scenario ends with the contact, which lands while the ego is
            # still crossing. Nothing here tries to complete the pass, and
            # that is a statement about the baseline rather than about the
            # manoeuvre: holding a lane against its own direction is not
            # expressible, because drive() steers along the lane it is on and
            # this one runs the other way. See the header.
            wait elapsed(6s)

        # ---- LORRY: slow, long, and holding its lane ----
        serial:
            lorry.assign_position() with:
                position(distance: lead_gap, ahead_of: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                lorry.drive() with:
                    speed(v_lorry)
                    keep_lane()
                wait elapsed(15s)

        # ---- ONCOMING: has the lane, and does not give it up ----
        serial:
            oncoming.assign_position() with:
                position(x: 139.00, y: -1.75, z: 0.00, h: 3.1416rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                oncoming.drive() with:
                    speed(v_oncoming)
                    keep_lane()
                wait @EGO_COMMITTED

            # Holds its line into the car coming up its own lane.
            emit ONCOMING_HELD_LINE
            one_of:
                oncoming.drive() with:
                    speed(v_oncoming)
                    keep_lane()
                wait elapsed(10s)

        # ---- Monitor: has the ego run out of room behind the lorry? ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: lorry, direction: euclidean) < commit_gap)
            emit EGO_COMMITTED

        # ---- Termination guard ----
        wait elapsed(16s)
