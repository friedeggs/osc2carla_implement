import "domain.osc"

# Junction crossing, written against the LOCAL backend's road network.
#
#   python -m osc2carla scenarios/local/local_crossing.osc --backend pygame
#
# The benchmark scenarios hard-code Town10HD_Opt coordinates and therefore
# only stage their conflict on CARLA.  This one is the mirror image: it is
# written against the `grid` town the local simulator synthesises (3x3
# junctions, 80 m apart, two lanes each way), so it runs on a laptop with no
# CARLA and no GPU.  It exercises the same compiler machinery the paper demos
# do -- relative placement, live distance monitors, emit/wait handshakes
# across actors, drive()/ram() -- on geometry that actually exists here.
#
# Grid geometry used below (junction centre at x = 80, y = 0):
#
#                             crosser
#                                |  x = 78.25, running +y
#                                v
#   ego, follower --->  y = 1.75  [ JUNCTION ]  --->  ego continues east
#   =============================================================
#
#   * the eastbound inner lane of the y = 0 road is y = 1.75; drive() follows
#     next()[0], which with --junction-turn straight carries the ego through.
#   * the southbound inner lane of the x = 80 road is x = 78.25.
#   * marker sits clear of both carriageways, on the corner outside the
#     junction box, and is the shared distance reference for the monitor.
#
# Timeline:
#   t = 0      all three vehicles at rest; launch on @go_signal.
#   t ~ 0-6    ego accelerates east; follower keeps station behind it;
#              crosser holds at its line with an active 0-speed controller.
#   t ~ 6      the ego closes inside approach_radius of the marker and the
#              monitor emits EGO_APPROACHING.
#   t ~ 6-8    crosser pulls out across the ego's path and holds its line
#              into it -- a failure to yield, the same shape as the CARLA
#              benchmark's red_light.
#   t = 18     termination guard.
scenario local_crossing:
    carla_map: map with:
        keep(it.map_file == "grid")

    env: environment

    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    follower: vehicle with:
        keep(it.name == "follower")
        keep(it.model == "vehicle.mercedes.coupe")
        keep(it.color == "200,200,200")

    crosser: vehicle with:
        keep(it.name == "crosser")
        keep(it.model == "vehicle.dodge.charger_2020")
        keep(it.color == "160,20,20")

    marker: stationary_object with:
        keep(it.name == "marker")
        keep(it.model == "static.prop.dirtdebris01")

    var v_ego: speed = 32kph
    var v_follower: speed = 28kph
    var v_crosser: speed = 30kph
    var follow_gap: length = 16m
    # How close the ego gets to the marker before the crosser pulls out.
    var approach_radius: length = 43m

    do parallel:
        env.assign_celestial_position(azimuth: 0deg, elevation: 70deg)

        marker.assign_position() with:
            position(x: 88.00, y: 88.00, z: -0.40, at: start)

        # ---- EGO: straight through the junction ----
        serial:
            ego.assign_position() with:
                position(x: 30.00, y: 81.75, z: 0.00, h: 0.0rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                ego.drive() with:
                    speed(v_ego)
                wait elapsed(18s)

        # ---- FOLLOWER: keeps station behind the ego ----
        serial:
            follower.assign_position() with:
                position(distance: follow_gap, behind: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                follower.drive() with:
                    speed(v_follower)
                wait elapsed(17s)

        # ---- CROSSER: waits at its line, then fails to yield ----
        serial:
            crosser.assign_position() with:
                position(x: 78.25, y: 66.00, z: 0.00, h: 1.5708rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # Held at the line by an active 0-speed controller: the last
            # applied VehicleControl latches, so an idle leaf would let the
            # car creep (same note as closed_loop_demo).
            one_of:
                crosser.drive() with:
                    speed(0kph)
                wait @EGO_APPROACHING

            emit CROSSER_PULLED_OUT
            one_of:
                crosser.drive() with:
                    speed(v_crosser)
                wait elapsed(12s)

        # ---- Monitor: is the ego committed to the junction? ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: marker, direction: euclidean) < approach_radius)
            emit EGO_APPROACHING

        # ---- Termination guard ----
        wait elapsed(18s)
