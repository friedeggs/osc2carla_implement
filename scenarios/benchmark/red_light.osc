import "domain.osc"

# Red-light violation at a signalised intersection (Town10HD_Opt, junction 189).
#
# Natural-language scenario:
#
#   The ego vehicle is crossing an intersection.  There is surrounding traffic
#   on both the ego's road and the crossing road.  While the ego is inside the
#   intersection, one of the vehicles on the crossing road runs its red light
#   and rams the ego from the side.
#
# Stage geometry (Town10HD_Opt junction 189, centre ~(-47.8, 20.4)):
#
#                       N  ^ +y
#                          |
#         ...............  |  ...............
#         westbound  y=16.6 -->  EGO road  (ego, lead, follower travel -x)
#         ---------------[ JUNCTION 189 ]---------------
#                          |
#                     x = -48.8  northbound cross road (+y)
#                          |          violator, stopper
#
#   * conflict point = (-48.75, 16.60): where the ego's westbound lane and the
#     violator's northbound lane intersect.
#   * ego enters from the east on the y = 16.6 lane, 50 m out.
#   * violator approaches from the north on the x = -48.8 lane, 42 m out, so it
#     arrives at the conflict point at roughly the same moment as the ego.
#     (CARLA's y axis points south, so the violator's +y heading enters the
#     junction from the ego's right and strikes the ego's right flank.)
#
# Actors (5 vehicles + 1 reference marker):
#   ego      Tesla Model 3 (camera vehicle), crossing westbound on green.
#   lead     Audi A2, 22 m ahead of the ego in the same lane; clears the
#            junction just before the ego enters it.
#   follower Mercedes coupe, 16 m behind the ego in the same lane.
#   violator CarlaCola truck on the crossing road: does not slow for its red
#            signal and T-bones the ego inside the junction.
#   stopper  Nissan Micra, 14 m behind the violator on the crossing road; obeys
#            the red and brakes to a stop at the stop line.  It is the contrast
#            that makes the violation legible: same approach, same signal, one
#            vehicle stops and the other does not.
#
# Timeline:
#   t = 0        all five vehicles spawn at rest, then launch on @go_signal.
#   t ~ 0-5      ego cruises westbound at 30 kph behind the lead vehicle;
#                violator and stopper cruise toward their red signal.
#   t ~ 4.6      ego crosses the stop line; the monitor emits EGO_IN_JUNCTION.
#                The stopper has already begun braking for the red and comes to
#                rest ~5 m short of its own stop line.
#   t ~ 6.2      ego reaches the conflict area; the monitor emits
#                EGO_AT_CONFLICT_POINT and the violator commits.
#   t ~ 6.5      violator, now in ram(target: ego), strikes the ego's right
#                flank inside the intersection (first contact, impulse ~5300).
#                The ego-mounted collision sensor overlays every contact.
#   t ~ 6.5-18   violator keeps pushing the ego across the junction; the
#                follower runs into the back of the wreck around t ~ 12.
#   t = 18       termination guard.
#
# Observed on CARLA 0.9.16 (Town10HD_Opt): ~417 collision events, first contact
# at t = 6.5 s.  Exact counts shift with CARLA build and physics substepping.
#
# Signal note: this baseline does not implement traffic lights (see "Coverage
# vs. the paper" in README.md) -- there is no action to set or read a signal
# phase, and scripted actors never yield to CARLA's own signals.  The red light
# is therefore expressed as behaviour and geometry: the violator enters the
# conflict area at speed on the ego's crossing phase and never yields, while
# the stopper on the same approach halts at the line.
scenario red_light:
    carla_map: map with:
        keep(it.map_file == "Town10HD_Opt")

    env: environment

    # --- Ego and its surrounding traffic (westbound road, y ~ 16.6) ---
    # NOTE: the ego is declared first because lead/follower are placed
    # topologically relative to it, and the initializer resolves relative
    # placement against the spawn transform of an already-spawned binding.
    ego: vehicle with:
        keep(it.name == "ego")
        keep(it.model == "vehicle.tesla.model3")

    lead: vehicle with:
        keep(it.name == "lead")
        keep(it.model == "vehicle.audi.a2")
        keep(it.color == "20,20,20")

    follower: vehicle with:
        keep(it.name == "follower")
        keep(it.model == "vehicle.mercedes.coupe")
        keep(it.color == "200,200,200")

    # --- Crossing-road traffic (northbound road, x ~ -48.8) ---
    violator: vehicle with:
        keep(it.name == "violator")
        keep(it.model == "vehicle.carlamotors.carlacola")

    stopper: vehicle with:
        keep(it.name == "stopper")
        keep(it.model == "vehicle.nissan.micra")
        keep(it.color == "0,90,160")

    # Ground decal marking the conflict point of the two lanes. It is the
    # fixed reference the junction-occupancy conditions are written against.
    # static.prop.dirtdebris01 is the flattest available prop and very rarely
    # reports contact -- but it is NOT collision-free: driving over it does
    # occasionally raise a collision event (measured in ~5% of benchmark runs),
    # so metrics must discount non-vehicle contacts rather than trust the prop.
    # z is set below grade so the decal sits flush with the road (the
    # initializer lifts every spawn by 0.5 m).
    conflict_point: stationary_object with:
        keep(it.name == "conflict_point")
        keep(it.model == "static.prop.dirtdebris01")

    # --- Speeds ---
    var v_ego: speed = 30kph
    var v_lead: speed = v_ego + 4kph
    var v_follower: speed = v_ego - 2kph
    var v_violator: speed = 32kph
    var v_stopper: speed = 30kph

    # --- Distances ---
    var lead_gap: length = 22m
    var follow_gap: length = 16m
    var queue_gap: length = 14m

    # The ego has entered the junction box once it is inside this radius of the
    # conflict point (junction 189 measures ~20 m from centre to stop line).
    var junction_entry_radius: length = 20m
    # ...and it occupies the conflict area -- the patch of the junction that the
    # violator's lane actually crosses -- inside this one.  The violator commits
    # on the inner event, not the outer one: at 30 kph the ego clears the
    # crossing lane in about 0.3 s, so a ram launched a whole second early turns
    # into a rear-end pursuit down the ego's lane instead of a side impact.
    var conflict_radius: length = 6m
    # The stopper starts braking this far from the conflict point, which puts
    # it at rest just short of its stop line.
    var stop_line_gap: length = 30m

    do parallel:
        # ---- Environment: bright daylight, sun high enough to read signals ----
        env.assign_celestial_position(azimuth: 0deg, elevation: 70deg)

        # ---- Conflict-point reference marker ----
        conflict_point.assign_position() with:
            position(x: -48.75, y: 16.60, z: -0.40, at: start)

        # ---- EGO: crossing the intersection westbound ----
        serial:
            ego.assign_position() with:
                position(x: 1.31, y: 16.69, z: 0.00, h: 3.1444rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # The ego never reacts: it holds its crossing speed throughout, so
            # the collision is entirely the violator's doing.
            one_of:
                ego.drive() with:
                    speed(v_ego)
                wait elapsed(17s)

        # ---- LEAD: same lane, clears the junction ahead of the ego ----
        serial:
            lead.assign_position() with:
                position(distance: lead_gap, ahead_of: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                lead.drive() with:
                    speed(v_lead)
                wait elapsed(17s)

        # ---- FOLLOWER: same lane, trails the ego into the junction ----
        serial:
            follower.assign_position() with:
                position(distance: follow_gap, behind: ego, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                follower.drive() with:
                    speed(v_follower)
                wait elapsed(17s)

        # ---- VIOLATOR: runs the red and rams the ego ----
        serial:
            # 42 m south of the conflict point: at v_violator that puts the
            # truck on the crossing lane at the same moment as the ego.
            violator.assign_position() with:
                position(x: -48.85, y: -25.70, z: 0.00, h: 1.5783rad, at: start)
                speed(0kph, at: start)

            wait @go_signal

            # Phase 1: approach the signal without slowing, unlike the stopper
            # on the same approach.  Lane following until the ego reaches the
            # conflict area.
            one_of:
                violator.drive() with:
                    speed(v_violator)
                wait @EGO_AT_CONFLICT_POINT

            # Phase 2: enter on the red and strike the ego's side.
            emit RED_LIGHT_RUN
            one_of:
                violator.ram(target: ego)
                wait elapsed(11s)

        # ---- STOPPER: same approach, obeys the red at the stop line ----
        serial:
            stopper.assign_position() with:
                position(distance: queue_gap, behind: violator, at: start)
                speed(0kph, at: start)

            wait @go_signal

            one_of:
                stopper.drive() with:
                    speed(v_stopper)
                wait rise(stopper.object_distance(reference: conflict_point, direction: euclidean) < stop_line_gap)

            stopper.change_speed(target: 0kph, rate_profile: asap)
            wait stopper.speed < 0.3kph

            # Hold at standstill: an active 0-speed controller is required or
            # the last applied VehicleControl latches and the car creeps
            # forward (same note as closed_loop_demo.osc).
            one_of:
                stopper.drive() with:
                    speed(0kph)
                wait elapsed(11s)

        # ---- Conflict monitor: how far the ego has committed to the junction ----
        serial:
            wait @go_signal
            wait rise(ego.object_distance(reference: conflict_point, direction: euclidean) < junction_entry_radius)
            emit EGO_IN_JUNCTION
            wait rise(ego.object_distance(reference: conflict_point, direction: euclidean) < conflict_radius)
            emit EGO_AT_CONFLICT_POINT

        # ---- Termination guard ----
        wait elapsed(18s)
